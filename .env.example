# All keys are OPTIONAL. The app degrades gracefully and RED-FLAGs missing sources.
# Primary OHLC (yahoo-finance2) and CFTC COT need NO key.

# FRED — free key for real yields / dollar index (https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# Twelve Data — free-tier fallback for OHLC when Yahoo/Stooq fail (https://twelvedata.com/pricing)
TWELVEDATA_API_KEY=

# Server port (default 3000)
PORT=3000
